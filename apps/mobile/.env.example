# Public HTTPS URL where this Expo server bundle is deployed.
EXPO_PUBLIC_MOBILE_API_URL=https://mobile-api.example.com

# Server-only values: Expo does not expose variables without EXPO_PUBLIC_ to
# native clients. These must also be available to the deployed Expo server.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://mobile-api.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MOBILE_APP_SCHEME=mobile
